{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-resizable",
    "updater:default",
    "process:allow-restart",
    "autostart:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
