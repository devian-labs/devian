{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devian Desktop",
  "version": "../version.json",
  "identifier": "dev.devian.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Devian Desktop",
        "width": 1024,
        "height": 624,
        "minWidth": 1024,
        "minHeight": 624,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devian-labs/devian/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDRjJGQTczMEU3RDM5MUYKUldRZk9YME9jL3J5TExzRC9GTmZhKzk1ci9ZbEtmNkhQcDRjUmQ2b0FCNUx4SUNPeWxOSnhxOEIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}